# Copy file nay thanh .env roi dien gia tri cua ban

# Client ID lay tu Spotify Developer Dashboard (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=dan_client_id_cua_ban_vao_day

# Redirect URI phai TRUNG KHOP tuyet doi voi cai khai bao trong Dashboard.
# Spotify yeu cau dung 127.0.0.1 (khong dung "localhost") cho http loopback.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

PORT=3000
